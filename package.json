{
  "name": "inkwell",
  "version": "1.0.0",
  "description": "Real-time collaborative whiteboard with CRDTs and capability links",
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx --env-file-if-exists=.env server/index.ts --production",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "loadtest": "tsx scripts/loadtest.ts"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "lib0": "^0.2.120",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.22.2",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "private": true,
  "engines": {
    "node": ">=22.13"
  }
}
