# Copy to .env (git-ignored). No secrets are needed to run Inkwell.
PORT=8787
HOST=127.0.0.1
DATA_DIR=./data
# Extra origins allowed to open WebSockets / create boards (same-origin is always allowed).
# In development the Vite server runs on 5173 and proxies to the API:
ALLOWED_ORIGINS=http://localhost:5173
# Set to true only behind a reverse proxy you control that sets X-Forwarded-For.
TRUST_PROXY=false
